require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    { paths: [process.argv[1]] },
  )', __dir__]).strip

# 1. First prepare the project so global variables are injected
prepare_react_native_project!

# 2. Set the platform target using the now-available variable
platform :ios, min_ios_version_supported

# 3. Workaround for React Native 0.85 prebuilt core issues
ENV['RCT_USE_PREBUILT_RNCORE'] = '0'

# 4. Use your correct Xcode target name (changed from FamilyHub to FamilyHub)
target 'FamilyHub' do
  config = use_native_modules!

  # 5. Enforce global static frameworks required by modern React Native and Firebase
  use_frameworks! :linkage => :static

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )
  end
end
